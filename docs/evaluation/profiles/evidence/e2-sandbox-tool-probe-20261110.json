  "baseline": "sha256:aa304bef66d983c4436991078d4e10ee1c85ba646caf29c10f27b616c292fa94",
  "eval_e2": "sha256:1ac6f429bb57a59e5dc547d2919010ccceb9a110cfa205eb545eba4647e0e2a2",
  "note": "eval-e2 was built FROM the baseline image so image build drift does not mix into this comparison"
 },
 "measured_on": "2026-11-10",
 "probe_script": [
  "export LC_ALL=C",
  "T=http://eval-meter:8099/allowed/x",
  "p(){ n=$1; shift; o=$(\"$@\" 2>&1 </dev/null); r=$?; printf '%s|rc=%s|%s\\n' \"$n\" \"$r\" \"$(printf %s \"$o\" | head -1 | cut -c1-90)\"; }",
  "for t in curl wget vim git jq unzip rg dig nslookup host ping nc telnet whois nmap node npm npx python python3 pip pip3 playwright playwright-cli grep sed awk base64 openssl xxd sqlite3 perl tar gzip find sort; do printf 'which:%s|%s\\n' \"$t\" \"$(command -v $t || echo MISSING)\"; done",
  "p ver:curl curl --version; p ver:wget wget --version; p ver:vim vim --version; p ver:git git --version; p ver:jq jq --version; p ver:unzip unzip -v; p ver:rg rg --version",
  "p ver:dig dig -v; p ver:nmap nmap --version; p ver:whois whois --version; p ver:node node -v; p ver:npm npm -v; p ver:npx npx -v; p ver:python3 python3 -V; p ver:pip3 pip3 --version; p ver:playwright playwright --version; p ver:playwright-cli playwright-cli --help",
  "p py:prefix python3 -c 'import sys;print(sys.version_info[:3],sys.prefix)'",
  "p py:stdlib python3 -c 'import json,ssl,urllib.request,hashlib,base64,sqlite3;print(\"ok\")'",
  "p py:requests python3 -c 'import requests;print(requests.__version__)'",
  "p node:eval node -e 'console.log(\"ok\")'",
  "p http:curl curl -s -o /dev/null -w '%{http_code}' --max-time 5 $T",
  "p http:wget bash -c \"wget -S -O /dev/null --timeout=5 --tries=1 $T 2>&1 | grep -m1 -E 'HTTP/|failed|rror'\"",
  "p http:python3 python3 -c \"",
  "import urllib.request,urllib.error",
  "try: print(urllib.request.urlopen('$T',timeout=5).status)",
  "except urllib.error.HTTPError as e: print(e.code)\"",
  "p http:node-fetch timeout 8 node -e \"fetch('$T').then(r=>console.log(r.status)).catch(e=>console.log('ERR',(e.cause&&e.cause.code)||e.message))\"",
  "p tcp:devtcp timeout 6 bash -c 'exec 3<>/dev/tcp/eval-meter/8099; printf \"GET /allowed/x HTTP/1.0\\r\\n\\r\\n\" >&3; head -1 <&3'",
  "p tcp:nc bash -c \"printf 'GET /allowed/x HTTP/1.0\\r\\n\\r\\n' | timeout 6 nc -w 5 eval-meter 8099 | head -1\"",
  "p tcp:nmap timeout 15 nmap -Pn -sT -p 8099 -n 172.30.9.10",
  "p dns:dig timeout 6 dig +short +time=2 +tries=1 eval-meter",
  "for d in /usr/share/nmap /usr/share/vim /etc/ssl/certs /usr/lib/node_modules /root/.cache/ms-playwright /usr/local/bin /usr/local/lib/python3.12 /usr/lib/python3 /usr/lib/python3.11 /app/skills /etc/passwd /etc/resolv.conf /etc/hosts; do [ -e $d ] && echo \"path:$d|present\" || echo \"path:$d|absent\"; done",
  "env | cut -d= -f1 | grep -iE 'proxy|cert|ca_|ssl|node|pip|python' | sort | tr '\\n' ' ' | sed 's/^/env-names|/'; echo"
 ],
