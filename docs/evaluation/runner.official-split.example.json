    "verify_interval_seconds": 10,
    "ca_bundle": "/etc/ssl/certs/ca-certificates.crt",
    "expected_provider_name": "PrimeIntellect"
  },
  "findings": {
    "vocabulary_path": "/srv/abc2lab-eval/vocabulary.json",
