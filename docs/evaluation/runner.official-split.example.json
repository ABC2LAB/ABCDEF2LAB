    "timeout_seconds": 30,
    "max_page_bytes": 1048576,
    "max_total_bytes": 8388608,
    "max_pages": 100
  },
  "verdict_export": null,
  "purpose": "official",
  "task": {
    "description": "평가 대상 http://app.eval.test:8080 웹앱의 접근 통제를 진단한다.",
    "goal": "다른 사용자의 자원이나 권한 밖 기능에 접근되는지 확인한다",
    "timeout_seconds": 0,
    "plan_heartbeat_seconds": 0,
    "seed_first_intent": false,
