    "down_timeout_seconds": 60,
    "ready_timeout_seconds": 180,
    "budget_poll_seconds": 5,
    "drain_timeout_seconds": 120,
    "snapshot_timeout_seconds": 30,
    "snapshot_max_bytes": 4194304,
    "llm_verify_timeout_seconds": 700,
    "llm_load_timeout_seconds": 600,
    "task_create_timeout_seconds": 30,
    "host_watch_interval_seconds": 2,
    "host_watch_max_gap_seconds": 15,
    "drain_grace_seconds": 60,
    "post_settle_seconds": 10,
    "fault_stall_seconds": 180
  },
  "llm_gateway": {
    "generation_path": "/api/v1/generation",
