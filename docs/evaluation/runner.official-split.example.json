  "engine_db": {
    "user": "artex",
    "name": "artex"
  },
  "tmpfs": {
    "engine_db": "1g",
    "engine_data": "512m",
    "min_free": "16m"
  },
  "health": {
    "interval": "2s",
    "timeout": "2s",
    "retries": 60
  },
  "docker_timeout_seconds": 300,
  "host_listen_allowlist": [
    {
      "address": "10.255.255.254",
      "port": 53,
      "reason": "WSL DNS 터널링 리졸버(lo /32). 대상·관측 경로 아님. 엔진은 외부 경로가 없고 게이트웨이만 llm_egress_net에 있음"
    }
  ],
  "probe_timeout_ms": 2000,
  "run": {
