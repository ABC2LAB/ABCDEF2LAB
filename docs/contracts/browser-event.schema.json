{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Browser execution event v1 proposal",
  "description": "Proposed host event projection. Validate with Draft202012Validator and FormatChecker. Does not issue authority or validate provenance, calendar validity without a format checker, sequence continuity, uint64 range, registry contents, durable commit, counts against events, or cross-event bindings.",
  "type": "object",
  "properties": {
    "version": {"const":"abc2lab.browser-event/v1"},
    "event_id": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},
    "seq": {"type":"string","pattern":"^[1-9][0-9]{0,19}$"},
    "at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$"
    },
    "kind": {
      "enum": [
        "session.started",
        "action.started",
        "action.finished",
        "request.observed",
        "attempt.result",
        "ingress.rejected",
        "session.fenced",
        "session.closed"
      ]
    },
    "source": {"type":"string","enum":["host","proxy","e2"]},
    "task_ref": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},
    "run_ref": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},
    "intent_id": {"type":"string","pattern":"^[1-9][0-9]{0,19}$"},
    "call_ref": {"anyOf":[{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},{"type":"null"}]},
    "command_ref": {"anyOf":[{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},{"type":"null"}]},
    "browser_session_ref": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},
    "phase": {"const":"recon"},
    "action_ref": {"anyOf":[{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},{"type":"null"}]},
    "request_ref": {"anyOf":[{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},{"type":"null"}]},
    "attempt_ref": {"anyOf":[{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},{"type":"null"}]},
    "payload": {"type":"object"}
  },
  "required": [
    "version",
    "event_id",
    "seq",
    "at",
    "kind",
    "source",
    "task_ref",
    "run_ref",
    "intent_id",
    "call_ref",
    "command_ref",
    "browser_session_ref",
    "phase",
    "action_ref",
    "request_ref",
    "attempt_ref",
    "payload"
  ],
  "additionalProperties": false,
  "$defs": {
    "session.started": {
      "type": "object",
      "properties": {
        "grant_ref": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},
        "policy_revision": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},
        "budget_ref": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},
        "limits_ref": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},
        "runtime_ref": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},
        "crawl_permission": {"type":"string","enum":["read_only","approved_writes"]},
        "test_environment_ref": {"anyOf":[{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},{"type":"null"}]},
        "reset_proof_ref": {"anyOf":[{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},{"type":"null"}]},
        "browser_profile": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cookie_storage": {"const":"disabled"},
            "service_workers": {"const":"blocked"},
            "certificate_trust": {"enum":["platform","dedicated_ca","spki_list"]},
            "ca_sha256": {"anyOf":[{"type":"string","pattern":"^[0-9a-f]{64}$"},{"type":"null"}]},
            "spki_list_sha256": {"anyOf":[{"type":"string","pattern":"^[0-9a-f]{64}$"},{"type":"null"}]},
            "certificate_errors_ignored": {"type":"boolean"},
            "chromium_flags": {"type":"array","maxItems":64,"uniqueItems":true,"items":{"type":"string","pattern":"^--[a-z0-9][a-z0-9-]{0,79}$"}},
            "flags_profile_ref": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128}
          },
          "required": [
            "cookie_storage",
            "service_workers",
            "certificate_trust",
            "ca_sha256",
            "spki_list_sha256",
            "certificate_errors_ignored",
            "chromium_flags",
            "flags_profile_ref"
          ],
          "allOf": [
            {
              "if": {"properties":{"certificate_trust":{"const":"platform"}},"required":["certificate_trust"]},
              "then": {"properties":{"ca_sha256":{"type":"null"},"spki_list_sha256":{"type":"null"}}}
            },
            {
              "if": {"properties":{"certificate_trust":{"const":"dedicated_ca"}},"required":["certificate_trust"]},
              "then": {"properties":{"ca_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"spki_list_sha256":{"type":"null"}}}
            },
            {
              "if": {"properties":{"certificate_trust":{"const":"spki_list"}},"required":["certificate_trust"]},
              "then": {"properties":{"ca_sha256":{"type":"null"},"spki_list_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}
            }
          ]
        }
      },
      "required": [
        "grant_ref",
        "policy_revision",
        "budget_ref",
        "limits_ref",
        "runtime_ref",
        "crawl_permission",
        "test_environment_ref",
        "reset_proof_ref",
        "browser_profile"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties":{"crawl_permission":{"const":"approved_writes"}},"required":["crawl_permission"]},
          "then": {"properties":{"test_environment_ref":{"type":"string"},"reset_proof_ref":{"type":"string"}}}
        }
      ]
    },
    "action.started": {
      "type": "object",
      "properties": {"operation":{"type":"string","enum":["navigate","wait_for_selector"]}},
      "required": ["operation"],
      "additionalProperties": false
    },
    "action.finished": {
      "type": "object",
      "properties": {
        "status": {"type":"string","enum":["succeeded","failed","timed_out","cancelled"]},
        "reason": {"type":"string","enum":["complete","driver_failed","timeout","fenced","unsupported"]},
        "basis": {"enum":["driver_report","host_control"],"type":"string"},
        "duration_ms": {"type":"string","pattern":"^(0|[1-9][0-9]{0,19})$"}
      },
      "required": ["status","reason","basis","duration_ms"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties":{"status":{"const":"failed"}},"required":["status"]},
          "then": {"properties":{"reason":{"enum":["driver_failed","unsupported"]}}}
        },
        {"if":{"properties":{"status":{"const":"timed_out"}},"required":["status"]},"then":{"properties":{"reason":{"const":"timeout"}}}},
        {"if":{"properties":{"status":{"const":"cancelled"}},"required":["status"]},"then":{"properties":{"reason":{"const":"fenced"}}}},
        {
          "if": {"properties":{"reason":{"const":"complete"}},"required":["reason"]},
          "then": {"properties":{"status":{"const":"succeeded"},"basis":{"const":"driver_report"}}}
        }
      ]
    },
    "request.observed": {
      "type": "object",
      "properties": {
        "method": {"type":"string","enum":["GET","HEAD","POST","PUT","PATCH","DELETE","OPTIONS","OTHER"]},
        "destination_scope": {"type":"string","enum":["approved","outside","invalid"]},
        "endpoint_ref": {"anyOf":[{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},{"type":"null"}]},
        "path_scope_ref": {"anyOf":[{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},{"type":"null"}]}
      },
      "required": ["method","destination_scope","endpoint_ref","path_scope_ref"],
      "additionalProperties": false
    },
    "attempt.result": {
      "type": "object",
      "properties": {
        "request_class": {"type":"string","enum":["application_http","proxy_transport"]},
        "e2_version": {"const":"e2-http-v1"},
        "policy_revision": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},
        "rule_ref": {"anyOf":[{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},{"type":"null"}]},
        "e2_sequence": {"type":"string","pattern":"^[1-9][0-9]{0,19}$"},
        "method": {"type":"string","enum":["GET","HEAD","POST","PUT","PATCH","DELETE","OPTIONS","OTHER"]},
        "decision": {"type":"string","enum":["allowed","denied","unsupported"]},
        "reason": {
          "type": "string",
          "enum": [
            "complete",
            "unsupported",
            "policy_denied",
            "closed",
            "audit_failed",
            "expired",
            "revoked",
            "budget_exhausted",
            "transport_failed",
            "unknown",
            "attempt_limit",
            "denial_limit",
            "transient_limit",
            "unknown_limit",
            "invalid"
          ]
        },
        "forward_attempted": {"type":"boolean"},
        "request_written": {"type":"boolean"},
        "response_received": {"type":"boolean"},
        "response_complete": {"type":"boolean"},
        "not_sent": {"type":"boolean"},
        "audit_complete": {"type":"boolean"},
        "status_code": {"anyOf":[{"type":"integer","minimum":100,"maximum":599},{"type":"null"}]}
      },
      "required": [
        "request_class",
        "e2_version",
        "policy_revision",
        "rule_ref",
        "e2_sequence",
        "method",
        "decision",
        "reason",
        "forward_attempted",
        "request_written",
        "response_received",
        "response_complete",
        "not_sent",
        "audit_complete",
        "status_code"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties":{"decision":{"const":"allowed"}},"required":["decision"]},
          "then": {"properties":{"reason":{"enum":["complete","closed","transport_failed","unknown","audit_failed"]}}}
        },
        {
          "if": {"properties":{"decision":{"const":"unsupported"}},"required":["decision"]},
          "then": {"properties":{"reason":{"const":"unsupported"}}}
        },
        {
          "if": {"properties":{"decision":{"const":"denied"}},"required":["decision"]},
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "policy_denied",
                  "closed",
                  "audit_failed",
                  "expired",
                  "revoked",
                  "budget_exhausted",
                  "attempt_limit",
                  "denial_limit",
                  "transient_limit",
                  "unknown_limit",
                  "invalid"
                ]
              },
              "not_sent": {"const":true}
            }
          }
        },
        {
          "if": {"properties":{"not_sent":{"const":true}},"required":["not_sent"]},
          "then": {
            "properties": {
              "forward_attempted": {"const":false},
              "request_written": {"const":false},
              "response_received": {"const":false},
              "response_complete": {"const":false}
            }
          }
        },
        {
          "if": {"properties":{"request_written":{"const":true}},"required":["request_written"]},
          "then": {"properties":{"forward_attempted":{"const":true},"not_sent":{"const":false}}}
        },
        {
          "if": {"properties":{"response_received":{"const":true}},"required":["response_received"]},
          "then": {"properties":{"forward_attempted":{"const":true},"not_sent":{"const":false},"status_code":{"type":"integer"}}}
        },
        {
          "if": {"properties":{"response_received":{"const":false}},"required":["response_received"]},
          "then": {"properties":{"status_code":{"type":"null"},"response_complete":{"const":false}}}
        },
        {
          "if": {"properties":{"response_complete":{"const":true}},"required":["response_complete"]},
          "then": {"properties":{"response_received":{"const":true}}}
        },
        {
          "if": {"properties":{"reason":{"const":"complete"}},"required":["reason"]},
          "then": {
            "properties": {
              "decision": {"const":"allowed"},
              "response_received": {"const":true},
              "response_complete": {"const":true},
              "not_sent": {"const":false}
            }
          }
        },
        {"if":{"properties":{"decision":{"const":"unsupported"}},"required":["decision"]},"then":{"properties":{"not_sent":{"const":true}}}}
      ]
    },
    "ingress.rejected": {
      "type": "object",
      "properties": {
        "layer": {"type":"string","enum":["application_http","proxy_transport"]},
        "reason": {
          "type": "string",
          "enum": [
            "parse_failed",
            "tls_failed",
            "unsupported",
            "admission_closed",
            "event_sink_failed",
            "invalid_binding",
            "crawl_write_blocked",
            "preflight_blocked",
            "dangerous_request",
            "queue_full",
            "queue_timeout"
          ]
        }
      },
      "required": ["layer","reason"],
      "additionalProperties": false
    },
    "session.fenced": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "enum": [
            "normal_close",
            "user_stop",
            "paused",
            "revoked",
            "expired",
            "budget_exhausted",
            "attempt_limit",
            "denial_limit",
            "transient_limit",
            "unknown_limit",
            "resource_limit",
            "audit_failed",
            "event_sink_failed",
            "invalid_binding",
            "driver_failed",
            "setup_failed",
            "runtime_unavailable",
            "drain_timeout",
            "unknown"
          ]
        }
      },
      "required": ["reason"],
      "additionalProperties": false
    },
    "session.closed": {
      "type": "object",
      "properties": {
        "status": {"type":"string","enum":["completed","stopped","failed","incomplete"]},
        "reason": {
          "type": "string",
          "enum": [
            "normal_close",
            "user_stop",
            "paused",
            "revoked",
            "expired",
            "budget_exhausted",
            "attempt_limit",
            "denial_limit",
            "transient_limit",
            "unknown_limit",
            "resource_limit",
            "audit_failed",
            "event_sink_failed",
            "invalid_binding",
            "driver_failed",
            "setup_failed",
            "runtime_unavailable",
            "drain_timeout",
            "unknown"
          ]
        },
        "process_drained": {"type":"boolean"},
        "proxy_drained": {"type":"boolean"},
        "audit_complete": {"type":"boolean"},
        "event_log_complete": {"type":"boolean"},
        "host_correlation_complete": {"type":"boolean"},
        "counts": {
          "type": "object",
          "properties": {
            "observed_requests": {"anyOf":[{"type":"string","pattern":"^(0|[1-9][0-9]{0,19})$"},{"type":"null"}]},
            "attempt_results": {"anyOf":[{"type":"string","pattern":"^(0|[1-9][0-9]{0,19})$"},{"type":"null"}]},
            "forward_attempted": {"anyOf":[{"type":"string","pattern":"^(0|[1-9][0-9]{0,19})$"},{"type":"null"}]},
            "request_written": {"anyOf":[{"type":"string","pattern":"^(0|[1-9][0-9]{0,19})$"},{"type":"null"}]},
            "responses_received": {"anyOf":[{"type":"string","pattern":"^(0|[1-9][0-9]{0,19})$"},{"type":"null"}]},
            "denied": {"anyOf":[{"type":"string","pattern":"^(0|[1-9][0-9]{0,19})$"},{"type":"null"}]},
            "unsupported": {"anyOf":[{"type":"string","pattern":"^(0|[1-9][0-9]{0,19})$"},{"type":"null"}]},
            "unknown": {"anyOf":[{"type":"string","pattern":"^(0|[1-9][0-9]{0,19})$"},{"type":"null"}]},
            "unresolved_requests": {"anyOf":[{"type":"string","pattern":"^(0|[1-9][0-9]{0,19})$"},{"type":"null"}]},
            "unresolved_attempts": {"anyOf":[{"type":"string","pattern":"^(0|[1-9][0-9]{0,19})$"},{"type":"null"}]},
            "dropped_events": {"anyOf":[{"type":"string","pattern":"^(0|[1-9][0-9]{0,19})$"},{"type":"null"}]},
            "local_write_blocked": {"anyOf":[{"type":"string","pattern":"^(0|[1-9][0-9]{0,19})$"},{"type":"null"}]},
            "preflight_blocked": {"anyOf":[{"type":"string","pattern":"^(0|[1-9][0-9]{0,19})$"},{"type":"null"}]},
            "queue_rejected": {"anyOf":[{"type":"string","pattern":"^(0|[1-9][0-9]{0,19})$"},{"type":"null"}]}
          },
          "required": [
            "observed_requests",
            "attempt_results",
            "forward_attempted",
            "request_written",
            "responses_received",
            "denied",
            "unsupported",
            "unknown",
            "unresolved_requests",
            "unresolved_attempts",
            "dropped_events",
            "local_write_blocked",
            "preflight_blocked",
            "queue_rejected"
          ],
          "additionalProperties": false
        }
      },
      "required": ["status","reason","process_drained","proxy_drained","audit_complete","event_log_complete","host_correlation_complete","counts"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties":{"status":{"const":"stopped"}},"required":["status"]},
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "user_stop",
                  "paused",
                  "revoked",
                  "expired",
                  "budget_exhausted",
                  "attempt_limit",
                  "denial_limit",
                  "transient_limit",
                  "unknown_limit",
                  "resource_limit"
                ]
              }
            }
          }
        },
        {
          "if": {"properties":{"status":{"const":"failed"}},"required":["status"]},
          "then": {"properties":{"reason":{"enum":["invalid_binding","driver_failed","setup_failed","runtime_unavailable"]}}}
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties":{"kind":{"const":"session.started"}},"required":["kind"]},
      "then": {
        "properties": {
          "source": {"const":"host"},
          "payload": {"$ref":"#/$defs/session.started"},
          "call_ref": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},
          "command_ref": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},
          "action_ref": {"type":"null"},
          "attempt_ref": {"type":"null"},
          "request_ref": {"type":"null"}
        }
      }
    },
    {
      "if": {"properties":{"kind":{"const":"action.started"}},"required":["kind"]},
      "then": {
        "properties": {
          "source": {"const":"host"},
          "payload": {"$ref":"#/$defs/action.started"},
          "call_ref": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},
          "command_ref": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},
          "action_ref": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},
          "attempt_ref": {"type":"null"},
          "request_ref": {"type":"null"}
        }
      }
    },
    {
      "if": {"properties":{"kind":{"const":"action.finished"}},"required":["kind"]},
      "then": {
        "properties": {
          "source": {"const":"host"},
          "payload": {"$ref":"#/$defs/action.finished"},
          "call_ref": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},
          "command_ref": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},
          "action_ref": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},
          "attempt_ref": {"type":"null"},
          "request_ref": {"type":"null"}
        }
      }
    },
    {
      "if": {"properties":{"kind":{"const":"request.observed"}},"required":["kind"]},
      "then": {
        "properties": {
          "source": {"const":"proxy"},
          "payload": {"$ref":"#/$defs/request.observed"},
          "call_ref": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},
          "command_ref": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},
          "action_ref": {"type":"null"},
          "attempt_ref": {"type":"null"},
          "request_ref": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128}
        }
      }
    },
    {
      "if": {"properties":{"kind":{"const":"attempt.result"}},"required":["kind"]},
      "then": {
        "properties": {
          "source": {"const":"e2"},
          "payload": {"$ref":"#/$defs/attempt.result"},
          "call_ref": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},
          "command_ref": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},
          "action_ref": {"type":"null"},
          "attempt_ref": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128}
        }
      }
    },
    {
      "if": {"properties":{"kind":{"const":"ingress.rejected"}},"required":["kind"]},
      "then": {
        "properties": {
          "source": {"const":"proxy"},
          "payload": {"$ref":"#/$defs/ingress.rejected"},
          "call_ref": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},
          "command_ref": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},
          "action_ref": {"type":"null"},
          "attempt_ref": {"type":"null"}
        }
      }
    },
    {
      "if": {"properties":{"kind":{"const":"session.fenced"}},"required":["kind"]},
      "then": {
        "properties": {
          "source": {"const":"host"},
          "payload": {"$ref":"#/$defs/session.fenced"},
          "call_ref": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},
          "command_ref": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},
          "action_ref": {"type":"null"},
          "attempt_ref": {"type":"null"},
          "request_ref": {"type":"null"}
        }
      }
    },
    {
      "if": {"properties":{"kind":{"const":"session.closed"}},"required":["kind"]},
      "then": {
        "properties": {
          "source": {"const":"host"},
          "payload": {"$ref":"#/$defs/session.closed"},
          "action_ref": {"type":"null"},
          "attempt_ref": {"type":"null"},
          "request_ref": {"type":"null"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {"const":"attempt.result"},
          "payload": {"properties":{"request_class":{"const":"application_http"}},"required":["request_class"]}
        },
        "required": ["kind","payload"]
      },
      "then": {"properties":{"request_ref":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128}}}
    },
    {
      "if": {
        "properties": {
          "kind": {"const":"attempt.result"},
          "payload": {"properties":{"request_class":{"const":"proxy_transport"}},"required":["request_class"]}
        },
        "required": ["kind","payload"]
      },
      "then": {"properties":{"request_ref":{"type":"null"}}}
    },
    {
      "if": {
        "properties": {"kind":{"const":"ingress.rejected"},"payload":{"properties":{"layer":{"const":"application_http"}},"required":["layer"]}},
        "required": ["kind","payload"]
      },
      "then": {"properties":{"request_ref":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128}}}
    },
    {
      "if": {
        "properties": {"kind":{"const":"ingress.rejected"},"payload":{"properties":{"layer":{"const":"proxy_transport"}},"required":["layer"]}},
        "required": ["kind","payload"]
      },
      "then": {"properties":{"request_ref":{"type":"null"}}}
    },
    {
      "if": {
        "properties": {"kind":{"const":"session.closed"},"payload":{"properties":{"status":{"const":"completed"}},"required":["status"]}},
        "required": ["kind","payload"]
      },
      "then": {
        "properties": {
          "call_ref": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},
          "command_ref": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},
          "payload": {
            "properties": {
              "reason": {"const":"normal_close"},
              "process_drained": {"const":true},
              "proxy_drained": {"const":true},
              "audit_complete": {"const":true},
              "event_log_complete": {"const":true},
              "host_correlation_complete": {"const":true},
              "counts": {
                "properties": {
                  "observed_requests": {"type":"string","pattern":"^(0|[1-9][0-9]{0,19})$"},
                  "attempt_results": {"type":"string","pattern":"^(0|[1-9][0-9]{0,19})$"},
                  "forward_attempted": {"type":"string","pattern":"^(0|[1-9][0-9]{0,19})$"},
                  "request_written": {"type":"string","pattern":"^(0|[1-9][0-9]{0,19})$"},
                  "responses_received": {"type":"string","pattern":"^(0|[1-9][0-9]{0,19})$"},
                  "denied": {"type":"string","pattern":"^(0|[1-9][0-9]{0,19})$"},
                  "unsupported": {"type":"string","pattern":"^(0|[1-9][0-9]{0,19})$"},
                  "unknown": {"type":"string","pattern":"^(0|[1-9][0-9]{0,19})$"},
                  "unresolved_requests": {"const":"0"},
                  "unresolved_attempts": {"const":"0"},
                  "dropped_events": {"const":"0"},
                  "local_write_blocked": {"type":"string","pattern":"^(0|[1-9][0-9]{0,19})$"},
                  "preflight_blocked": {"type":"string","pattern":"^(0|[1-9][0-9]{0,19})$"},
                  "queue_rejected": {"type":"string","pattern":"^(0|[1-9][0-9]{0,19})$"}
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"kind":{"const":"action.finished"},"payload":{"properties":{"status":{"const":"succeeded"}},"required":["status"]}},
        "required": ["kind","payload"]
      },
      "then": {"properties":{"payload":{"properties":{"basis":{"const":"driver_report"},"reason":{"const":"complete"}}}}}
    }
  ]
}
