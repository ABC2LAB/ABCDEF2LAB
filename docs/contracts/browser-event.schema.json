{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Browser execution event v1 proposal",
  "description": "Proposed host event projection. Validate with Draft202012Validator and FormatChecker. Does not issue authority or validate provenance, calendar validity without a format checker, registry contents, durable commit, sequence continuity, counts against events, or cross-event bindings. Decimal string patterns enforce uint64 bounds.",
  "type": "object",
  "properties": {
    "version": {"const":"abc2lab.browser-event/v1"},
    "event_id": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},
    "seq": {"$ref":"#/$defs/positive_uint64"},
    "at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$"
    },
    "kind": {
      "enum": [
        "session.started",
        "action.started",
        "action.finished",
        "request.observed",
        "attempt.result",
        "ingress.rejected",
        "session.fenced",
        "session.closed"
      ]
    },
    "source": {"type":"string","enum":["host","proxy","e2"]},
    "task_ref": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},
    "run_ref": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},
    "intent_id": {"$ref":"#/$defs/positive_uint64"},
    "call_ref": {"anyOf":[{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},{"type":"null"}]},
    "command_ref": {"anyOf":[{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},{"type":"null"}]},
    "browser_session_ref": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},
    "phase": {"const":"recon"},
    "action_ref": {"anyOf":[{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},{"type":"null"}]},
    "request_ref": {"anyOf":[{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},{"type":"null"}]},
    "attempt_ref": {"anyOf":[{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},{"type":"null"}]},
    "payload": {"type":"object"}
  },
  "required": [
    "version",
    "event_id",
    "seq",
    "at",
    "kind",
    "source",
    "task_ref",
    "run_ref",
    "intent_id",
    "call_ref",
    "command_ref",
    "browser_session_ref",
    "phase",
    "action_ref",
    "request_ref",
    "attempt_ref",
    "payload"
  ],
  "additionalProperties": false,
  "$defs": {
    "session.started": {
      "type": "object",
      "properties": {
        "grant_ref": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},
        "policy_revision": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},
        "budget_ref": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},
        "limits_ref": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},
        "runtime_ref": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},
        "crawl_permission": {"type":"string","enum":["read_only","approved_writes"]},
        "test_environment_ref": {"anyOf":[{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},{"type":"null"}]},
        "reset_proof_ref": {"anyOf":[{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},{"type":"null"}]},
        "browser_profile": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cookie_storage": {"const":"disabled"},
            "service_workers": {"const":"blocked"},
            "certificate_trust": {"enum":["platform","dedicated_ca"]},
            "ca_sha256": {"anyOf":[{"type":"string","pattern":"^[0-9a-f]{64}$"},{"type":"null"}]},
            "spki_list_sha256": {"anyOf":[{"type":"string","pattern":"^[0-9a-f]{64}$"},{"type":"null"}]},
            "certificate_errors_ignored": {"const":false},
            "chromium_flags": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^--[a-z0-9][a-z0-9-]{0,79}$",
                "not": {
                  "enum": [
                    "--ignore-certificate-errors",
                    "--ignore-certificate-errors-spki-list",
                    "--allow-insecure-localhost",
                    "--no-sandbox",
                    "--disable-web-security"
                  ]
                }
              }
            },
            "flags_profile_ref": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128}
          },
          "required": [
            "cookie_storage",
            "service_workers",
            "certificate_trust",
            "ca_sha256",
            "spki_list_sha256",
            "certificate_errors_ignored",
            "chromium_flags",
            "flags_profile_ref"
          ],
          "allOf": [
            {
              "if": {"properties":{"certificate_trust":{"const":"platform"}},"required":["certificate_trust"]},
              "then": {"properties":{"ca_sha256":{"type":"null"},"spki_list_sha256":{"type":"null"}}}
            },
            {
              "if": {"properties":{"certificate_trust":{"const":"dedicated_ca"}},"required":["certificate_trust"]},
              "then": {"properties":{"ca_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"spki_list_sha256":{"type":"null"}}}
            }
          ]
        }
      },
      "required": [
        "grant_ref",
        "policy_revision",
        "budget_ref",
        "limits_ref",
        "runtime_ref",
        "crawl_permission",
        "test_environment_ref",
        "reset_proof_ref",
        "browser_profile"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties":{"crawl_permission":{"const":"approved_writes"}},"required":["crawl_permission"]},
          "then": {"properties":{"test_environment_ref":{"type":"string"},"reset_proof_ref":{"type":"string"}}}
        }
      ]
    },
    "action.started": {
      "type": "object",
      "properties": {"operation":{"type":"string","enum":["navigate","wait_for_selector"]}},
      "required": ["operation"],
      "additionalProperties": false
    },
    "action.finished": {
      "type": "object",
      "properties": {
        "status": {"type":"string","enum":["succeeded","failed","timed_out","cancelled"]},
        "reason": {"type":"string","enum":["complete","driver_failed","timeout","fenced","unsupported"]},
        "basis": {"enum":["driver_report","host_control"],"type":"string"},
        "duration_ms": {"$ref":"#/$defs/uint64"}
      },
      "required": ["status","reason","basis","duration_ms"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties":{"status":{"const":"failed"}},"required":["status"]},
          "then": {"properties":{"reason":{"enum":["driver_failed","unsupported"]}}}
        },
        {"if":{"properties":{"status":{"const":"timed_out"}},"required":["status"]},"then":{"properties":{"reason":{"const":"timeout"}}}},
        {"if":{"properties":{"status":{"const":"cancelled"}},"required":["status"]},"then":{"properties":{"reason":{"const":"fenced"}}}},
        {
          "if": {"properties":{"reason":{"const":"complete"}},"required":["reason"]},
          "then": {"properties":{"status":{"const":"succeeded"},"basis":{"const":"driver_report"}}}
        }
      ]
    },
    "request.observed": {
      "type": "object",
      "properties": {
        "method": {"type":"string","enum":["GET","HEAD","POST","PUT","PATCH","DELETE","OPTIONS","OTHER"]},
        "destination_scope": {"type":"string","enum":["approved","outside","invalid"]},
        "endpoint_ref": {"anyOf":[{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},{"type":"null"}]},
        "path_scope_ref": {"anyOf":[{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},{"type":"null"}]}
      },
      "required": ["method","destination_scope","endpoint_ref","path_scope_ref"],
      "additionalProperties": false
    },
    "attempt.result": {
      "type": "object",
      "properties": {
        "request_class": {"type":"string","enum":["application_http","proxy_transport"]},
        "e2_version": {"const":"e2-http-v1"},
        "policy_revision": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},
        "rule_ref": {"anyOf":[{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$","maxLength":128},{"type":"null"}]},
        "e2_sequence": {"$ref":"#/$defs/positive_uint64"},
        "method": {"type":"string","enum":["GET","HEAD","POST","PUT","PATCH","DELETE","OPTIONS","OTHER"]},
        "decision": {"type":"string","enum":["allowed","denied","unsupported"]},
        "reason": {
          "type": "string",
          "enum": [
            "complete",
            "unsupported",
            "policy_denied",
            "closed",
            "audit_failed",
            "expired",
            "revoked",
            "budget_exhausted",
            "transport_failed",
            "unknown",
            "attempt_limit",
            "denial_limit",
            "transient_limit",
            "unknown_limit",
            "invalid"
          ]
        },
        "forward_attempted": {"type":"boolean"},
        "request_written": {"type":"boolean"},
        "response_received": {"type":"boolean"},
        "response_complete": {"type":"boolean"},
        "not_sent": {"type":"boolean"},
        "audit_complete": {"type":"boolean"},
        "status_code": {"anyOf":[{"type":"integer","minimum":100,"maximum":999},{"type":"null"}]}
      },
      "required": [
        "request_class",
        "e2_version",
        "policy_revision",
        "rule_ref",
        "e2_sequence",
        "method",
        "decision",
        "reason",
        "forward_attempted",
        "request_written",
        "response_received",
        "response_complete",
        "not_sent",
        "audit_complete",
        "status_code"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties":{"decision":{"const":"allowed"}},"required":["decision"]},
          "then": {"properties":{"reason":{"enum":["complete","closed","transport_failed","unknown"]}}}
        },
        {
          "if": {"properties":{"decision":{"const":"unsupported"}},"required":["decision"]},
          "then": {"properties":{"reason":{"const":"unsupported"}}}
        },
        {
          "if": {"properties":{"decision":{"const":"denied"}},"required":["decision"]},
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "policy_denied",
                  "closed",
                  "audit_failed",
                  "expired",
                  "revoked",
                  "budget_exhausted",
                  "attempt_limit",
                  "denial_limit",
                  "transient_limit",
                  "unknown_limit",
                  "invalid"
                ]
              },
              "not_sent": {"const":true}
            }
          }
        },
        {
          "if": {"properties":{"not_sent":{"const":true}},"required":["not_sent"]},
          "then": {
            "properties": {
              "forward_attempted": {"const":false},
              "request_written": {"const":false},
              "response_received": {"const":false},
              "response_complete": {"const":false}
            }
          }
        },
        {
          "if": {"properties":{"request_written":{"const":true}},"required":["request_written"]},
          "then": {"properties":{"forward_attempted":{"const":true},"not_sent":{"const":false}}}
        },
        {
          "if": {"properties":{"response_received":{"const":true}},"required":["response_received"]},
          "then": {"properties":{"forward_attempted":{"const":true},"not_sent":{"const":false},"status_code":{"type":"integer"}}}
        },
        {
          "if": {"properties":{"response_received":{"const":false}},"required":["response_received"]},
          "then": {"properties":{"status_code":{"type":"null"},"response_complete":{"const":false}}}
        },
        {
          "if": {"properties":{"response_complete":{"const":true}},"required":["response_complete"]},
          "then": {"properties":{"response_received":{"const":true}}}
        },
        {
          "if": {"properties":{"reason":{"const":"complete"}},"required":["reason"]},
          "then": {
            "properties": {
              "decision": {"const":"allowed"},
              "response_received": {"const":true},
              "response_complete": {"const":true},
              "not_sent": {"const":false}
            }
          }
        },
        {"if":{"properties":{"decision":{"const":"unsupported"}},"required":["decision"]},"then":{"properties":{"not_sent":{"const":true}}}},
        {
          "if": {"properties":{"not_sent":{"const":false}},"required":["not_sent"]},
          "then": {"properties":{"forward_attempted":{"const":true}}}
        },
        {
          "if": {"properties":{"reason":{"const":"audit_failed"}},"required":["reason"]},
          "then": {"properties":{"audit_complete":{"const":false}}}
        },
        {
          "if": {"properties":{"reason":{"const":"unknown"}},"required":["reason"]},
          "then": {"properties":{"decision":{"const":"allowed"},"forward_attempted":{"const":true},"not_sent":{"const":false}}}
        },
        {
          "if": {"properties":{"reason":{"enum":["closed","transport_failed","audit_failed"]}},"required":["reason"]},
          "then": {"properties":{"not_sent":{"const":true}}}
        }
      ]
    },
    "ingress.rejected": {
      "type": "object",
      "properties": {
        "layer": {"type":"string","enum":["application_http","proxy_transport"]},
        "reason": {
          "type": "string",
          "enum": [
            "parse_failed",
            "tls_failed",
            "unsupported",
            "admission_closed",
            "event_sink_failed",
            "invalid_binding",
            "crawl_write_blocked",
            "preflight_blocked",
            "dangerous_request",
            "queue_full",
            "queue_timeout",
            "scope_blocked"
          ]
        }
      },
      "required": ["layer","reason"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {"reason":{"enum":["crawl_write_blocked","preflight_blocked","dangerous_request","queue_full","queue_timeout"]}},
            "required": ["reason"]
          },
          "then": {"properties":{"layer":{"const":"application_http"}}}
        },
        {
          "if": {"properties":{"reason":{"const":"tls_failed"}},"required":["reason"]},
          "then": {"properties":{"layer":{"const":"proxy_transport"}}}
        }
      ]
    },
    "session.fenced": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "enum": [
            "normal_close",
            "user_stop",
            "paused",
            "revoked",
            "expired",
            "budget_exhausted",
            "attempt_limit",
            "denial_limit",
            "transient_limit",
            "unknown_limit",
            "resource_limit",
            "audit_failed",
            "event_sink_failed",
            "invalid_binding",
            "driver_failed",
            "setup_failed",
            "runtime_unavailable",
            "drain_timeout",
            "unknown"
          ]
        }
      },
      "required": ["reason"],
      "additionalProperties": false
    },
    "session.closed": {
      "type": "object",
      "properties": {
        "status": {"type":"string","enum":["completed","stopped","failed","incomplete"]},
        "reason": {
          "type": "string",
          "enum": [
            "normal_close",
            "user_stop",
            "paused",
            "revoked",
            "expired",
            "budget_exhausted",
            "attempt_limit",
            "denial_limit",
            "transient_limit",
            "unknown_limit",
            "resource_limit",
            "audit_failed",
            "event_sink_failed",
            "invalid_binding",
            "driver_failed",
            "setup_failed",
            "runtime_unavailable",
            "drain_timeout",
            "unknown"
          ]
        },
        "process_drained": {"type":"boolean"},
        "proxy_drained": {"type":"boolean"},
        "audit_complete": {"type":"boolean"},
        "event_log_complete": {"type":"boolean"},
        "host_correlation_complete": {"type":"boolean"},
        "counts": {
          "type": "object",
          "properties": {
            "observed_requests": {"anyOf":[{"$ref":"#/$defs/uint64"},{"type":"null"}]},
            "attempt_results": {"anyOf":[{"$ref":"#/$defs/uint64"},{"type":"null"}]},
            "forward_attempted": {"anyOf":[{"$ref":"#/$defs/uint64"},{"type":"null"}]},
            "request_written": {"anyOf":[{"$ref":"#/$defs/uint64"},{"type":"null"}]},
            "responses_received": {"anyOf":[{"$ref":"#/$defs/uint64"},{"type":"null"}]},
            "denied": {"anyOf":[{"$ref":"#/$defs/uint64"},{"type":"null"}]},
            "unsupported": {"anyOf":[{"$ref":"#/$defs/uint64"},{"type":"null"}]},
            "unknown": {"anyOf":[{"$ref":"#/$defs/uint64"},{"type":"null"}]},
            "unresolved_requests": {"anyOf":[{"$ref":"#/$defs/uint64"},{"type":"null"}]},
            "unresolved_attempts": {"anyOf":[{"$ref":"#/$defs/uint64"},{"type":"null"}]},
            "dropped_events": {"anyOf":[{"$ref":"#/$defs/uint64"},{"type":"null"}]},
            "local_write_blocked": {"anyOf":[{"$ref":"#/$defs/uint64"},{"type":"null"}]},
            "preflight_blocked": {"anyOf":[{"$ref":"#/$defs/uint64"},{"type":"null"}]},
            "queue_rejected": {"anyOf":[{"$ref":"#/$defs/uint64"},{"type":"null"}]},
            "ingress_rejected": {"anyOf":[{"$ref":"#/$defs/uint64"},{"type":"null"}]},
            "application_attempt_results": {"anyOf":[{"$ref":"#/$defs/uint64"},{"type":"null"}]},
            "application_ingress_rejected": {"anyOf":[{"$ref":"#/$defs/uint64"},{"type":"null"}]},
            "ingress_by_reason": {
              "type": "object",
              "properties": {
                "parse_failed": {"anyOf":[{"$ref":"#/$defs/uint64"},{"type":"null"}]},
                "tls_failed": {"anyOf":[{"$ref":"#/$defs/uint64"},{"type":"null"}]},
                "unsupported": {"anyOf":[{"$ref":"#/$defs/uint64"},{"type":"null"}]},
                "admission_closed": {"anyOf":[{"$ref":"#/$defs/uint64"},{"type":"null"}]},
                "event_sink_failed": {"anyOf":[{"$ref":"#/$defs/uint64"},{"type":"null"}]},
                "invalid_binding": {"anyOf":[{"$ref":"#/$defs/uint64"},{"type":"null"}]},
                "crawl_write_blocked": {"anyOf":[{"$ref":"#/$defs/uint64"},{"type":"null"}]},
                "preflight_blocked": {"anyOf":[{"$ref":"#/$defs/uint64"},{"type":"null"}]},
                "dangerous_request": {"anyOf":[{"$ref":"#/$defs/uint64"},{"type":"null"}]},
                "queue_full": {"anyOf":[{"$ref":"#/$defs/uint64"},{"type":"null"}]},
                "queue_timeout": {"anyOf":[{"$ref":"#/$defs/uint64"},{"type":"null"}]},
                "scope_blocked": {"anyOf":[{"$ref":"#/$defs/uint64"},{"type":"null"}]}
              },
              "required": [
                "parse_failed",
                "tls_failed",
                "unsupported",
                "admission_closed",
                "event_sink_failed",
                "invalid_binding",
                "crawl_write_blocked",
                "preflight_blocked",
                "dangerous_request",
                "queue_full",
                "queue_timeout",
                "scope_blocked"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "observed_requests",
            "attempt_results",
            "forward_attempted",
            "request_written",
            "responses_received",
            "denied",
            "unsupported",
            "unknown",
            "unresolved_requests",
            "unresolved_attempts",
            "dropped_events",
            "local_write_blocked",
            "preflight_blocked",
            "queue_rejected",
            "ingress_rejected",
            "application_attempt_results",
            "application_ingress_rejected",
            "ingress_by_reason"
          ],
          "additionalProperties": false
        },
        "exploration_limits": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 8,
          "items": {"enum":["cookies_disabled","service_worker_blocked","encoded_response_unknown","auth_not_prepared"]}
        }
      },
      "required": [
        "status",
        "reason",
        "process_drained",
        "proxy_drained",
        "audit_complete",
        "event_log_complete",
        "host_correlation_complete",
        "counts",
        "exploration_limits"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties":{"status":{"const":"stopped"}},"required":["status"]},
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "user_stop",
                  "paused",
                  "revoked",
                  "expired",
                  "budget_exhausted",
                  "attempt_limit",
                  "denial_limit",
                  "transient_limit",
                  "unknown_limit",
                  "resource_limit"
                ]
              }
            }
          }
        },
        {
          "if": {"properties":{"status":{"const":"failed"}},"required":["status"]},
          "then": {"properties":{"reason":{"enum":["invalid_binding","driver_failed","setup_failed","runtime_unavailable"]}}}
        },
        {
          "if": {"properties":{"status":{"enum":["completed","stopped","failed"]}},"required":["status"]},
          "then": {
            "properties": {
              "process_drained": {"const":true},
              "proxy_drained": {"const":true},
              "audit_complete": {"const":true},
              "event_log_complete": {"const":true},
              "host_correlation_complete": {"const":true},
              "counts": {
                "properties": {
                  "observed_requests": {"$ref":"#/$defs/uint64"},
                  "attempt_results": {"$ref":"#/$defs/uint64"},
                  "forward_attempted": {"$ref":"#/$defs/uint64"},
                  "request_written": {"$ref":"#/$defs/uint64"},
                  "responses_received": {"$ref":"#/$defs/uint64"},
                  "denied": {"$ref":"#/$defs/uint64"},
                  "unsupported": {"$ref":"#/$defs/uint64"},
                  "unknown": {"$ref":"#/$defs/uint64"},
                  "unresolved_requests": {"const":"0"},
                  "unresolved_attempts": {"const":"0"},
                  "dropped_events": {"const":"0"},
                  "local_write_blocked": {"$ref":"#/$defs/uint64"},
                  "preflight_blocked": {"$ref":"#/$defs/uint64"},
                  "queue_rejected": {"$ref":"#/$defs/uint64"},
                  "ingress_rejected": {"$ref":"#/$defs/uint64"},
                  "application_attempt_results": {"$ref":"#/$defs/uint64"},
                  "application_ingress_rejected": {"$ref":"#/$defs/uint64"},
                  "ingress_by_reason": {
                    "properties": {
                      "parse_failed": {"$ref":"#/$defs/uint64"},
                      "tls_failed": {"$ref":"#/$defs/uint64"},
                      "unsupported": {"$ref":"#/$defs/uint64"},
                      "admission_closed": {"$ref":"#/$defs/uint64"},
                      "event_sink_failed": {"$ref":"#/$defs/uint64"},
                      "invalid_binding": {"$ref":"#/$defs/uint64"},
                      "crawl_write_blocked": {"$ref":"#/$defs/uint64"},
                      "preflight_blocked": {"$ref":"#/$defs/uint64"},
                      "dangerous_request": {"$ref":"#/$defs/uint64"},
                      "queue_full": {"$ref":"#/$defs/uint64"},
                      "queue_timeout": {"$ref":"#/$defs/uint64"},
                      "scope_blocked": {"$ref":"#/$defs/uint64"}
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "positive_uint64": {
      "type": "string",
