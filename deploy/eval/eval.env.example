# 평가 회차 설정 예시. 복사해서 eval.env로 쓰고, eval.env는 커밋하지 않는다(*.env 제외 규칙).
# 값은 예시 자리표시자다. 이미지·모델·포트·경로를 코드에 박지 않고 여기서만 정한다.

# --- 이미지 (digest 또는 소스 커밋 태그로 고정) ---
# baseline: base/artex-import를 깨끗한 작업 트리에서 빌드한 이미지 / 개선 후: 빌드한 dev 커밋 이미지
EVAL_ENGINE_IMAGE=
EVAL_ENGINE_DB_IMAGE=
EVAL_TARGET_IMAGE=
EVAL_METER_IMAGE=

# --- 엔진 ---
EVAL_ENGINE_API_PORT=
# 엔진 이미지가 API를 듣는 컨테이너 내부 포트(이미지 CMD의 -addr와 일치)
EVAL_ENGINE_CONTAINER_PORT=
EVAL_ENGINE_ADMIN_PASSWORD=
EVAL_ENGINE_DB_USER=
EVAL_ENGINE_DB_PASSWORD=
EVAL_ENGINE_DB_NAME=
EVAL_HEALTH_INTERVAL=
EVAL_HEALTH_TIMEOUT=
EVAL_HEALTH_RETRIES=
# 평가 회차 엔진 DB(tmpfs) 크기 상한. 예: 1g
EVAL_ENGINE_DB_TMPFS_SIZE=

# --- LLM (평가는 외부 API 허용, 평가 프로토콜 §6. 모델 식별자·제공자·샘플링 고정) ---
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_STREAM=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# 같은 머신의 로컬 LLM을 쓸 때만(compose.local-llm.yaml overlay):
EVAL_LLM_HOSTNAME=
EVAL_LLM_HOST_IP=

# --- 대상·계측기·관측 front ---
EVAL_TARGET_PORT=
EVAL_METER_PORT=
EVAL_OBS_PORT=
EVAL_OBS_HOST_PORT=
# 관측 front가 통과시킬 등록 GET 경로 1개(대상 앱의 스코어보드 경로)
EVAL_OBS_PATH=

# --- 러너 ---
# 증거 디렉터리: 러너 uid 소유 0700, 회차마다 새로. 계측기·관측 front가 이 uid로 쓴다.
EVAL_EVIDENCE_DIR=
EVAL_RUNNER_UID=
EVAL_RUNNER_GID=
