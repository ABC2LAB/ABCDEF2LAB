# 평가 회차 비밀 값만 둔다. 복사해서 레포 밖에 두고(러너 설정 secrets_env_file), 커밋하지 않는다.
# 러너는 이 파일을 읽지 않는다. compose가 --env-file로 직접 읽어 컨테이너 환경에만 넣는다.
# 이미지·포트·모델·LLM 주소·관측 경로 같은 비밀 아닌 값은 러너 설정과 사전검사 선언에서 오며,
# 러너가 프로세스 환경으로 넘긴다(compose 보간은 셸 환경이 이 파일보다 우선). 여기 적어도 쓰이지 않는다.

# --- 엔진 ---
EVAL_ENGINE_ADMIN_PASSWORD=
EVAL_ENGINE_DB_PASSWORD=

# --- LLM API 키 (api 백엔드만, 평가 프로토콜 §6). LLM 게이트웨이 컨테이너에만 들어가고 엔진은 받지 않는다 ---
EVAL_LLM_API_KEY=
