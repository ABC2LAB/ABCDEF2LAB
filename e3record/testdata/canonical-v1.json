    "limit": "Inclusive 65536 canonical UTF-8 bytes.",
    "input_kinds": {
      "json": "value is a JSON value; decode integers exactly, never through a float.",
      "uint64": "value is an unsigned decimal integer string; preserve its unsigned type before validating signed int64 range.",
      "float64": "value is a float string, including NaN and +/-Inf; construct a float before validating.",
      "utf8_hex": "value is the hex encoding of raw string bytes; reject invalid UTF-8 before JSON replacement can occur.",
      "repeat_string": "repeat value exactly count times before canonical encoding.",
      "time": "value is the RFC3339 instant described above."
    },
    "expected": "utf8 is the exact expected canonical text. utf8_repeat expands prefix + text * count + suffix to the exact expected bytes. byte_length and sha256 refer to UTF-8 bytes; error is the expected fixed rejection code."
  },
